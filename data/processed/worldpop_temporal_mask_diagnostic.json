  "source_evidence": {
    "documented": [
      "The product consists of modelled gridded population estimates.",
      "Annual binary built-settlement datasets are modelled and interpolated between input timepoints.",
      "Oceans and major inland waterbodies in the mastergrid are encoded as NoData."
    ],
    "empirical_pattern": "Within the fixed analysis geometry, mask changes are monotonic NoData-to-valid transitions with no valid-to-NoData or multi-switch cells. This is consistent with, but does not by itself prove, modelled settlement expansion.",
